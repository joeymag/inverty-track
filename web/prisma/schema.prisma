// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String            @id @default(uuid())
  accessToken      String?
  expires          DateTime?
  isOnline         Boolean
  scope            String?
  shop             String
  state            String
  apiKey           String
  onlineAccessInfo OnlineAccessInfo?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model OnlineAccessInfo {
  id                  String          @id @default(uuid())
  session             Session?        @relation(fields: [sessionId], references: [id])
  sessionId           String?         @unique
  expiresIn           Int
  associatedUserScope String
  associatedUser      AssociatedUser?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model AssociatedUser {
  id                 String            @id @default(uuid())
  onlineAccessInfo   OnlineAccessInfo? @relation(fields: [onlineAccessInfoId], references: [id])
  onlineAccessInfoId String?           @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  userId             BigInt
  firstName          String
  lastName           String
  email              String
  accountOwner       Boolean
  locale             String
  collaborator       Boolean
  emailVerified      Boolean
}

model SkuMapping {
  id                    String   @id @default(uuid())
  shop                  String
  masterVariantId       String
  masterSku             String?
  masterProductTitle    String?
  masterInventoryItemId String
  childVariantId        String
  childSku              String?
  childProductTitle     String?
  childInventoryItemId  String
  unitsPerChildUnit     Int      @default(1)
  locationId            String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([shop, childVariantId])
  @@index([shop, masterVariantId])
}

model ProcessedOrder {
  id          String   @id
  shop        String
  processedAt DateTime @default(now())

  @@index([shop])
}
